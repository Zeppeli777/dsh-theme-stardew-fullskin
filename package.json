{
  "name": "dsh-theme-stardew-fullskin",
  "version": "0.2.2",
  "description": "Stardew Valley theme for the DeepSeek Harness Web UI: a self-contained frontend that replaces the served dist, with the Junimo NPC dialog, farm-select mode picker, quest journal HUD, valley calendar with seasons and weather, 8-bit sound feedback, and wallpaper system.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./web/*": "./web/*",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "web"
  ],
  "scripts": {
    "dev": "node scripts/dev-server.mjs"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "stardew-valley",
    "theme",
    "pixel-art",
    "web-ui"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zeppeli777/dsh-theme-stardew-fullskin.git"
  },
  "homepage": "https://github.com/Zeppeli777/dsh-theme-stardew-fullskin#readme",
  "bugs": {
    "url": "https://github.com/Zeppeli777/dsh-theme-stardew-fullskin/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-web-app": "^0.1.2-rc.1 || ^0.1.5-rc.1 || ^0.1.7-rc.2 || ^0.2.1-rc.3"
  }
}
